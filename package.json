{
  "name": "pi-session-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Archive pi sessions by moving them out of the active session root; pi-web sees the change with no code change of its own.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test *.test.mjs"
  }
}
